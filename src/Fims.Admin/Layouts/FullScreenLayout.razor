@namespace Fims.Admin.Layouts

@using Fims.Common
@using Fims.Client.Shared.Shared.NavMenu
@using Telerik.Blazor.Components.Common.Icon

@inherits LayoutComponentBase
@inject ITelerikStringLocalizer Localizer
@inject LocalStorageInterop LocalStorageInterop
@*@inject ILocalStorageService LocalStorage*@
@*@inject Services.PublicHttp Http*@
@inject MainLayoutState Layout


<TelerikRootComponent>
    <div class="header">
        <div class="nav-container" style="margin-left: 2em; margin-right: 2em;">
            <img style="width: 30px;" src="_content/Fims.Client.Shared/images/fimsinspect.svg">
            <div class="title">
                <h1>@($"{Constants.FimsTitle} (FIMS {Constants.FimsVersion})")</h1>
            </div>
            <DigitalClock></DigitalClock>
            <LoginDisplay></LoginDisplay>
        </div>
    </div>

    <div class="fims-full-body">
        @Body
    </div>

</TelerikRootComponent>


<style>
    /* most styles for header are defined in main.css */
    .header {
        height: 60px;
        background-color: cornflowerblue
    }
</style>

<style>
    .fims-full-body {
        background-color: #d8d9e8;
        padding: 10px;
        height: calc(100vh - 60px);
    }
</style>