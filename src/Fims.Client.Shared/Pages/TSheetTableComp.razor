@using Telerik.Blazor.Components.Common.Icon


<TelerikTabStrip @bind-ActiveTabIndex="@ActiveCategoryTabIndex">
    @foreach (var TCategory in MyTSheetSpec.TCategories)
    {
        <TabStripTab>
            <HeaderTemplate>
                @*                <span class="k-icon flag italy-flag"></span>*@
                @*                <span class="fa fa-car" style="font-size:20px;color:red;"></span>*@
                @*                  <span class="fa fa-temperature-high"></span><strong>@TCategory</strong>*@
                @*                    <div style="background-color:orange;color:@SelectedColor;padding:20px;"><span class="fa fa-temperature-high"></span><strong>@TCategory</strong></div>*@
                <div class="tab-parent "><span class="fa fa-temperature-high"></span><strong>@TCategory</strong></div>
            </HeaderTemplate>
            <Content>
                <TelerikGrid Data=@MyTSheetSpec.TItemSpecsInCategoryDict[TCategory]
                             EditMode="@GridEditMode.Incell"
                             SelectionMode="GridSelectionMode.Multiple"
                             @ref="@TItemSpecGrid"
                             OnUpdate="@UpdateHandler" OnEdit="@EditHandler"
                             OnRowRender="@OnRowRenderHandler"
                             Pageable="true"
                             Resizable="true"
                             Page="@Page">
                    <RowTemplate Context="itemspec">
                        <td>@itemspec.TestNo</td>

                        <td>
                            @itemspec.Title
                            <TelerikTooltip TargetSelector=".tooltip-target" />
                            <span title="@itemspec.RangeToolTip" class="tooltip-target" style="float:right"><TelerikIcon Icon="@FontIcon.QuestionCircle" /></span>
                        </td>

                        @if (itemspec.Channels == 1)
                        {
                            <td colspan="@MaxChannels" style="border-spacing: 5px; padding-top:10px; text-align: center;background-color: #81BEF7">
                                    @*<TelerikTextBox Id="payment-address-input" Name="name" TabIndex="3" Enabled="false" ValidateOn="ValidationEvent.Change" Class="txt-listview" Class="mb-md" Width="100%" *Width="12.4em" InputMode="email" Password="true"></TelerikTextBox>*@
                                <TelerikTextBox @bind-Value="@itemspec.Ch1Data" OnChange="@((object userinput) => TextBoxOnChangeHandler1(userinput, itemspec, "Ch1Data"))" PlaceHolder="Type Ch1LCL" Class="center-align" FillMode="ThemeConstants.TextBox.FillMode.Solid" Rounded="ThemeConstants.TextBox.Rounded.Medium" Size="ThemeConstants.TextBox.Size.Medium"></TelerikTextBox>
                                    @*<TelerikValidationMessage For="@(() => @itemspec.Ch1LCL)" />*@
                            </td>
                        }
                        else
                        {
                            <td style="border-spacing: 5px; padding-top:10px; text-align: center;background-color: #819FF7">
                                <TelerikTextBox @bind-Value="@itemspec.Ch1Data" OnChange="@((object userinput) => TextBoxOnChangeHandler1(userinput, itemspec, "Ch1Data"))" PlaceHolder="Type Ch1LCL" Class="mb-md right-align" FillMode="ThemeConstants.TextBox.FillMode.Solid" Rounded="ThemeConstants.TextBox.Rounded.Medium" Size="ThemeConstants.TextBox.Size.Medium"></TelerikTextBox>
                            </td>
                            <td style="border-spacing: 5px; padding-top:10px; text-align: center;background-color: #819FF7">
                                <TelerikTextBox @bind-Value="@itemspec.Ch2Data" OnChange="@((object userinput) => TextBoxOnChangeHandler2(userinput, itemspec, "Ch2Data"))" PlaceHolder="Type Ch2LCL" Class="mb-md right-align" FillMode="ThemeConstants.TextBox.FillMode.Solid" Rounded="ThemeConstants.TextBox.Rounded.Medium" Size="ThemeConstants.TextBox.Size.Medium"></TelerikTextBox>
                            </td>
                            <td style="border-spacing: 5px; padding-top:10px; text-align: center;background-color: #819FF7">
                                <TelerikTextBox @bind-Value="@itemspec.Ch3Data" OnChange="@((object userinput) => TextBoxOnChangeHandler3(userinput, itemspec, "Ch3Data"))" PlaceHolder="Type Ch3LCL" Class="mb-md right-align" FillMode="ThemeConstants.TextBox.FillMode.Solid" Rounded="ThemeConstants.TextBox.Rounded.Medium" Size="ThemeConstants.TextBox.Size.Medium"></TelerikTextBox>
                            </td>
                            @if (MaxChannels > 3)
                            {
                            <td style="border-spacing: 5px; padding-top:10px; text-align: center;background-color: #819FF7">
                                <TelerikTextBox @bind-Value="@itemspec.Ch4Data" OnChange="@((object userinput) => TextBoxOnChangeHandler4(userinput, itemspec, "Ch4Data"))" PlaceHolder="Type Ch4LCL" Class="mb-md right-align" FillMode="ThemeConstants.TextBox.FillMode.Solid" Rounded="ThemeConstants.TextBox.Rounded.Medium" Size="ThemeConstants.TextBox.Size.Medium"></TelerikTextBox>
                            </td>
                            }
                        }
                    </RowTemplate>

                    @*<GridToolBar>
                        <GridSearchBox Width="150px"></GridSearchBox>
                        <span class="k-toolbar-spacer"></span>
                        <GridCommandButton Command="ExcelExport" Icon="file-excel">@Localizer["Grid_ExcelExport"]</GridCommandButton>
                        <GridCommandButton Command="CsvExport" Icon="file-csv">@Localizer["Grid_CsvExport"]</GridCommandButton>
                    </GridToolBar>*@

                    <GridColumns>
                        <GridColumn Field="@nameof(TItemSpec.TestNo)" Width="100px" Title="TestNo" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>Test No</strong></HeaderTemplate>
                            <Template>
                                <span class="k-badge k-badge-lg k-badge-solid k-badge-solid-success k-rounded-lg">@((context as TItemSpec).TestNo)</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Title)" Width="200px" Title="항목" OnCellRender="@OnCellRenderHandler" HeaderClass="align-right right-padding" TextAlign="@ColumnTextAlign.Right">
                            <HeaderTemplate><strong>시험항목</strong></HeaderTemplate>
                            @*<Template>
                                @{
                                var employee = context as Employee;
                                <img style="width: 30px;" src="./img/country-flags/@(employee.Country.ToLower()).png" />
                                }
                            </Template>
                            *@
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Ch1Data)" Width="100px" OnCellRender="@OnCellRenderHandler" Title="CH1" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH1</strong></HeaderTemplate>
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Ch2Data)" Width="100px" OnCellRender="@OnCellRenderHandler" Title="CH2" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH2</strong></HeaderTemplate>
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Ch3Data)" Width="100px" OnCellRender="@OnCellRenderHandler" Title="CH3" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH3</strong></HeaderTemplate>
                        </GridColumn>
                    @if (MaxChannels> 3)
                    {
                        <GridColumn Field="@nameof(TItemSpec.Ch4Data)" Width="100px" OnCellRender="@OnCellRenderHandler" Title="CH4" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH4</strong></HeaderTemplate>
                        </GridColumn>
                    }
                    </GridColumns>
                </TelerikGrid>

            </Content>
        </TabStripTab>
    }
</TelerikTabStrip>


<style>
    .italy-flag {
        background-image: url('https://demos.telerik.com/kendo-ui/content/web/drawer/italy-flag.png');
    }

    .germany-flag {
        background-image: url('https://demos.telerik.com/kendo-ui/content/web/drawer/germany-flag.png');
    }

    .france-flag {
        background-image: url('https://demos.telerik.com/kendo-ui/content/web/drawer/france-flag.png');
    }

    .flag {
        background-size: cover;
        margin-right: 8px;
    }
</style>

<style>
    .tab-parent .k-tabstrip-items li {
        color: yellow;
    }

        .tab-parent .k-tabstrip-items li.k-state-active,
        .tab-parent .k-tabstrip-items li.k-state-active ~ li {
            color: red;
        }
</style>


<style>
    /* CENTER */

    /* non-sortable headers */
    .k-grid th.center-me {
        text-align: center;
    }

    /* sortable headers */
    th.center-me .k-cell-inner > .k-link {
        justify-content: center;
    }

    /* RIGHT */

    /* non-sortable headers */
    .k-grid th.align-right {
        text-align: right;
    }

    /* sortable headers */
    th.align-right .k-cell-inner > .k-link {
        justify-content: right;
    }

    /* unbound and non-filterable columns */
    .k-grid-header th.align-right.right-padding {
        padding-right: 12px;
    }

    /* filterable grid, sortable non-filterable columns */
    .k-grid-header th.align-right.right-padding > .k-cell-inner {
        margin-right: 0;
    }

</style>

<style>
    .userinput-valid {
        color: green;
        font-weight: bold !important;
    }

    .userinput-invalid {
        color: red !important;
        font-weight: bold;
        opacity: 0.7;
    }
</style>

