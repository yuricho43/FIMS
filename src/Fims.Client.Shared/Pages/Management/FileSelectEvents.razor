@page "/management/fileselectevents"
@using Telerik.Blazor.Components.FileSelect;




<TelerikCard>
    <CardHeader>
        <CardTitle><h2 class="card-title mb-4" style="align-self:center"><strong>Spec Sheets 관리</strong></h2></CardTitle>
        <CardSubTitle>교체(Replace)</CardSubTitle>
    </CardHeader>

    <CardBody>

        <div class="row">
                <TelerikFileSelect OnSelect="@HandleFiles"
                                   OnRemove="@OnRemove">
                </TelerikFileSelect>
        </div>

        <TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" OnClick="OnUploadSpec">Upload Spec</TelerikButton>


    </CardBody>

    <CardFooter Class="k-hbox justify-space-between">
        <span>© 2023 FST (https://www.fstc.co.kr), All Rights Reserved.</span>
    </CardFooter>
</TelerikCard>

