@page "/Management/AddUserDialog"

<TelerikDialog Visible="true" Title="신규 Inspection 설비 추가">
    <DialogContent>

        <TelerikForm Model="@NewUserRegisterRequestModel"
                     @ref="@AddUserFormRef"
                     OnValidSubmit="@HandleValidSubmit"
                     OnInvalidSubmit="@HandleInvalidSubmit"
                     Width="500px">
            <FormValidation>
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidation>
            <FormItems>
                <FormItem Field="@nameof(NewUserRegisterRequestModel.FirstName)"></FormItem>
                <FormItem Field="@nameof(NewUserRegisterRequestModel.LastName)"></FormItem>
                <FormItem Field="@nameof(NewUserRegisterRequestModel.Email)">
                    <Template>
                        <label for="mail" class="k-label k-form-label">Email*:</label>
                        <TelerikTextBox Id="mail" @bind-Value="@NewUserRegisterRequestModel.Email" InputMode="email" PlaceHolder="example@domain.com"></TelerikTextBox>
                        <TelerikValidationMessage For="@(() => NewUserRegisterRequestModel.Email)"></TelerikValidationMessage>
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(NewUserRegisterRequestModel.Password)">
                    <Template>
                        <label for="pass" class="k-label k-form-label">Password*:</label>
                        <TelerikTextBox Id="pass" @bind-Value="@NewUserRegisterRequestModel.Password" Password="true"></TelerikTextBox>
                        <TelerikValidationMessage For="@(() => NewUserRegisterRequestModel.Password)"></TelerikValidationMessage>
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(NewUserRegisterRequestModel.Role)">
                    <Template>
                        <TelerikDropDownList Data="@Roles" @bind-Value="NewUserRegisterRequestModel.Role" Width="200px"></TelerikDropDownList>
                    </Template>
                </FormItem>
            </FormItems>

            <FormButtons>
                <TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)">등록</TelerikButton>
                <TelerikButton ButtonType="ButtonType.Button" OnClick="@OnAddUserDialogCancel">취소</TelerikButton>
            </FormButtons>
        </TelerikForm>

    </DialogContent>

@*    <DialogButtons>
        <TelerikButton OnClick="OnAddUserDialogCancel">취소</TelerikButton>
        <TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Success)" OnClick="OnAddUserDialogOK">OK</TelerikButton>
    </DialogButtons>
*@
</TelerikDialog>


