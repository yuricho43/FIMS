@page "/AddNewProductModal2"

<div class="modal @modalClass" tabindex="-1" role="dialog" style="display:@modalDisplay; overflow-y: auto;">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content dialog-background">
            <div class="modal-header dialog-header-background">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body dialog-body-background">

@*                <div class="flex-center">
                    <TelerikButton Icon="@FontIcon.Barcode" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)">바코드 촬영</TelerikButton>
                </div>
*@

                <EditForm Model="@NewTProductSpec"
                          @ref="@AddNewProductFormRef2"
                          OnValidSubmit="@HandleValidSubmit"
                          OnInvalidSubmit="@HandleInvalidSubmit">

                    <DataAnnotationsValidator />
 
@*                    <ValidationSummary />
*@
                    <div class="form-group row">
                        <label for="customer" class="col-sm-2 col-form-label">
                            고객
                        </label>
                        <div class="col-sm-10">
                            <InputText id="customer" @bind-Value="@NewTProductSpec.Customer" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="enduser" class="col-sm-2 col-form-label">
                            End User
                        </label>
                        <div class="col-sm-10">
                            <InputText id="enduser" @bind-Value="@NewTProductSpec.EndUser" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="model" class="col-sm-2 col-form-label">
                            모델
                        </label>
                        <div class="col-sm-10">
                            <InputSelect id="model" @bind-Value="@NewTProductSpec.ProductModel" class="form-control">
                                @foreach (var item in ProductModels)
                                {
                                    <option value="@item">@item</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="ptype" class="col-sm-2 col-form-label">
                            검사형태
                        </label>
                        <div class="col-sm-10">
                            <InputSelect id="ptype" @bind-Value="@NewTProductSpec.ProductType" class="form-control">
                                @foreach (var item in ProductTypes)
                                {
                                    <option value="@item">@item</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="sn" class="col-sm-2 col-form-label">
                            제품SN
                        </label>
                        <div class="col-sm-10">
                            <InputText id="sn" @bind-Value="@NewTProductSpec.ProductSerial" class="form-control" />
                        </div>
                    </div>





                    <div class="form-group">
                        <button type="submit" class="btn btn-danger btn-block"> 추가  </button>
                    </div>
                </EditForm>


            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal" @onclick="() => Close()">닫기</button>
            </div>
        </div>
    </div>
</div>


<style>
    .fims-dialog {
        /* margin-left: 50px;*/ 
        background-color: silver;
    }
</style>


<style>
    .dialog-background {
        color: darkblue;
        background-color:silver;
    }

    .dialog-header-background {
        color: darkred;
        background-color:silver;
    }
    .dialog-body-background {
        color: black;
        background-color:silver;
    }

</style>



@if (showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public RenderFragment Title { get; set; }

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    private string modalDisplay = "none;";
    private string modalClass = "";
    private bool   showBackdrop = false;

    public void Open()
    {
        modalDisplay = "block;";
        modalClass = "show";
        showBackdrop = true;
    }

    public void Close()
    {
        modalDisplay = "none";
        modalClass = "";
        showBackdrop = false;
    }
}