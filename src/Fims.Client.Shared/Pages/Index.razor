@page "/"

@attribute [Authorize]


<div class="fims-page">
    <TelerikStackLayout Class="bars-section" Orientation="StackLayoutOrientation.Vertical" HorizontalAlign="StackLayoutHorizontalAlign.Center" VerticalAlign="StackLayoutVerticalAlign.Center" Width="100%">

        <TelerikStackLayout Class="tools-bar" Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Center" VerticalAlign="StackLayoutVerticalAlign.Center" Spacing="50px" Width="100%" Height="40px">
            <TelerikButton OnClick="OnAddNewProductClicked" Icon="@FontIcon.PlusCircle" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)" Class="prod-register-button"><strong>검사설비추가</strong></TelerikButton>
            <TelerikButton OnClick="OnLoadSessionData" Icon="@FontIcon.CaretDoubleAltDown" ThemeColor="@(ThemeConstants.Button.ThemeColor.Warning)" Class="prod-register-button">
                @*@if (IsLoadingSession) {<span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>}*@
                <strong>저장목록 불러오기</strong>
            </TelerikButton>
            <TelerikButton OnClick="OnSaveSessionData" Icon="@FontIcon.CaretDoubleAltUp" ThemeColor="@(ThemeConstants.Button.ThemeColor.Warning)" Class="prod-register-button">
                @*@if (IsSavingSession) {<span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>}*@
                <strong>진행목록 저장</strong></TelerikButton>
        </TelerikStackLayout>
    
        <TelerikStackLayout Class="serials-bar" Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Center" VerticalAlign="StackLayoutVerticalAlign.Center" Spacing="50px" Width="100%" Height="40px">
            @if (ProductSerials != null)
            {
                <TelerikButtonGroup SelectionMode="  ButtonGroupSelectionMode.Single">
                    @foreach (string productSerial in ProductSerials)
                    {
                        <ButtonGroupToggleButton @bind-Selected="@ProductSerialsSelected[productSerial]" OnClick="@(() => OnProductSerialButtonGroupClick(productSerial))" Enabled="@(ProductSerialToTSheetSpecDict[productSerial].IsInspectionCompleted ? false: true)" ThemeColor="@(ProductSerialToTSheetSpecDict[productSerial].IsInspectionCompleted ? ThemeConstants.Button.ThemeColor.Error: ThemeConstants.Button.ThemeColor.Base)" Class="serial-button">
                            <strong>@productSerial</strong>
                            &nbsp;
                            @*<span class="badge badge-success" style="width: 30px">@TModelToTSheetSpecDict[equipmentModel].TItemSpecs.Count</span>*@
                        </ButtonGroupToggleButton>
                    }
                </TelerikButtonGroup>
            }
        </TelerikStackLayout>

    </TelerikStackLayout>
</div>



@if (CurrentTSheetSpec != null)
{
    <div class="fims-page">
        <TSheetComponent MyTSheetSpec="@CurrentTSheetSpec" TSheetInspectionCompleted="OnTSheetInspectionCompleted"></TSheetComponent>
    </div>
}



<TelerikDialog Visible="@AddNewProductDialogVisible" Title="검사설비 추가" Width="800px" Height="600px" Class="dialog-background">
    <DialogContent>
        <div class="flex-center">
            <TelerikButton Icon="@FontIcon.Barcode" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)">바코드 촬영</TelerikButton>
        </div>
        <br />
        <br />

        <TelerikForm Model="@NewTProductSpec"
                     @ref="@AddNewProductFormRef"
                     OnValidSubmit="@HandleValidSubmit"
                     OnInvalidSubmit="@HandleInvalidSubmit"
                     Orientation="FormOrientation.Horizontal">

            <FormValidation>
                @*<ErrorsList ShowErrors="ShowErrors" Errors="Errors" />*@
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidation>

            <FormItems>
                <FormItem Field="@nameof(NewTProductSpec.Customer)">
                    <Template>
                        @*<label for="customer" class="k-label k-form-label"><TelerikIcon Icon="@FontIcon.Gears" />거래처</label>*@
                        <label for="customer" class="k-label k-form-label">거래처</label>
                        <TelerikTextBox Id="customer" @bind-Value="@NewTProductSpec.Customer"></TelerikTextBox>
                        @*<TelerikValidationMessage For="@(() => NewTProductSpec.Customer)"></TelerikValidationMessage>*@
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(NewTProductSpec.EndUser)">
                    <Template>
                        <label for="enduser" class="k-label k-form-label">End User</label>
                        <TelerikTextBox Id="enduser" @bind-Value="@NewTProductSpec.EndUser"></TelerikTextBox>
                        @*<TelerikValidationMessage For="@(() => NewTProductSpec.EndUser)"></TelerikValidationMessage>*@
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(NewTProductSpec.ProductModel)">
                    <Template>
                        <label for="model" class="k-label k-form-label">Model</label>
                        <TelerikDropDownList Id="model" Data="@ProductModels" @bind-Value="@NewTProductSpec.ProductModel"></TelerikDropDownList>
                        @*<TelerikValidationMessage For="@(() => NewTProductSpec.ProductModel)"></TelerikValidationMessage>*@
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(NewTProductSpec.ProductType)">
                    <Template>
                        <label for="ptype" class="k-label k-form-label">검사형태</label>
                        <TelerikDropDownList Id="ptype" Data="@ProductTypes" @bind-Value="@NewTProductSpec.ProductType"></TelerikDropDownList>
                        @*<TelerikValidationMessage For="@(() => NewTProductSpec.ProductType)"></TelerikValidationMessage>*@
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(NewTProductSpec.ProductSerial)">
                    <Template>
                        <label for="sn" class="k-label k-form-label">Serial No.</label>
                        <TelerikTextBox Id="sn" @bind-Value="@NewTProductSpec.ProductSerial"></TelerikTextBox>
                        @*<TelerikValidationMessage For="@(() => NewTProductSpec.ProductSerial)"></TelerikValidationMessage>*@
                    </Template>
                </FormItem>
            </FormItems>

            <FormButtons>
                <TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" Size="Big">추가</TelerikButton>
                <TelerikButton ButtonType="ButtonType.Button" OnClick="@OnAddNewProductDialogCancel" Size="Big">나가기</TelerikButton>
            </FormButtons>

        </TelerikForm>

    </DialogContent>

    @*    <DialogButtons>
    <div class="flex-center">
    <TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" Size="Big">추가</TelerikButton>
    <TelerikButton ButtonType="ButtonType.Button" OnClick="@OnAddNewProductDialogCancel" Size="Big">취소</TelerikButton>
    </div>
    </DialogButtons>
    *@

</TelerikDialog>


