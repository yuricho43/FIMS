@page "/"

@attribute [Authorize]


<div class="fims-page">
    <TelerikStackLayout Class="bars-section" Orientation="StackLayoutOrientation.Vertical" HorizontalAlign="StackLayoutHorizontalAlign.Center" VerticalAlign="StackLayoutVerticalAlign.Center" Width="100%">
        <TelerikStackLayout Class="tools-bar" Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Center" VerticalAlign="StackLayoutVerticalAlign.Center" Spacing="50px" Width="100%" Height="50px">
            <TelerikButton OnClick="OnAddNewProductClicked" Icon="plus-circle" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)"><strong>제품등록</strong></TelerikButton>
            <TelerikButton OnClick="OnLoadSessionData" Icon="caret-double-alt-down" ThemeColor="@(ThemeConstants.Button.ThemeColor.Warning)"><strong>진행목록 불러오기</strong></TelerikButton>
            <TelerikButton OnClick="OnSaveSessionData" Icon="caret-double-alt-up" ThemeColor="@(ThemeConstants.Button.ThemeColor.Warning)"><strong>진행목록 저장</strong></TelerikButton>
        </TelerikStackLayout>
    
        <TelerikStackLayout Class="serials-bar" Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Center" VerticalAlign="StackLayoutVerticalAlign.Center" Spacing="50px" Width="100%" Height="50px">
            @if (ProductSerials != null)
            {
                <TelerikButtonGroup SelectionMode="  ButtonGroupSelectionMode.Single">
                    @foreach (string productSerial in ProductSerials)
                    {
                        var cool = ProductSerialsSelected[productSerial];
                        <ButtonGroupToggleButton @bind-Selected="@ProductSerialsSelected[productSerial]" OnClick="@(() => OnProductSerialButtonGroupClick(productSerial))" Enabled="@(ProductSerialToTSheetSpecDict[productSerial].IsInspectionCompleted ? false: true)" ThemeColor="@(ProductSerialToTSheetSpecDict[productSerial].IsInspectionCompleted ? ThemeConstants.Button.ThemeColor.Error: ThemeConstants.Button.ThemeColor.Base)" Class="serial-button">
                            <strong>@productSerial</strong>
                            &nbsp;
                            @*<span class="badge badge-success" style="width: 30px">@TModelToTSheetSpecDict[equipmentModel].TItemSpecs.Count</span>*@
                        </ButtonGroupToggleButton>
                    }
                </TelerikButtonGroup>
            }
        </TelerikStackLayout>
    </TelerikStackLayout>
</div>

<div class="fims-page">
    @if (CurrentTSheetSpec != null)
    {
        @*<TSheetGridComp MyTSheetSpec="@CurrentTSheetSpec"></TSheetGridComp>*@
        @*<TSheetTableComp MyTSheetSpec="@CurrentTSheetSpec"></TSheetTableComp>*@
        <TSheetComponent MyTSheetSpec="@CurrentTSheetSpec" TSheetInspectionCompleted="OnTSheetInspectionCompleted"></TSheetComponent>
    }
</div>

@if (AddNewProductDialogVisible)
{
    <AddNewProductDialog ProductAdded="AddTProduct"></AddNewProductDialog>
}


<TelerikNotification @ref="@IndexNotificationComponent"
                     Class="IndexNotification"
                     VerticalPosition="NotificationVerticalPosition.Top"
                     HorizontalPosition="NotificationHorizontalPosition.Right">
</TelerikNotification>


