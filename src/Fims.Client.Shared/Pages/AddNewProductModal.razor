@page "/AddNewProductModal"

<div class="modal @modalClass" tabindex="-1" role="dialog" style="display:@modalDisplay; overflow-y: auto;">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content dialog-background">
            <div class="modal-header dialog-header-background">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body dialog-body-background">

@*                <div class="flex-center">
                    <TelerikButton Icon="@FontIcon.Barcode" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)">바코드 촬영</TelerikButton>
                </div>
*@

                <TelerikForm Model="@NewTProductSpec"
                             @ref="@AddNewProductFormRef"
                             OnValidSubmit="@HandleValidSubmit"
                             OnInvalidSubmit="@HandleInvalidSubmit"
                             Orientation="FormOrientation.Horizontal">

                    <FormValidation>
                        <DataAnnotationsValidator></DataAnnotationsValidator>
                    </FormValidation>

                    <FormItems>
                        <FormItem Field="@nameof(NewTProductSpec.Customer)">
                            <Template>
                                <label for="customer" class="k-label k-form-label">고객</label>
                                <TelerikTextBox Id="customer" @bind-Value="@NewTProductSpec.Customer"></TelerikTextBox>
                            </Template>
                        </FormItem>
                        <FormItem Field="@nameof(NewTProductSpec.EndUser)">
                            <Template>
                                <label for="enduser" class="k-label k-form-label">End User</label>
                                <TelerikTextBox Id="enduser" @bind-Value="@NewTProductSpec.EndUser"></TelerikTextBox>
                            </Template>
                        </FormItem>

                        <FormItem Field="@nameof(NewTProductSpec.ProductModel)">
                            <Template>
                                <label for="model" class="k-label k-form-label">모델</label>
                                <TelerikDropDownList Id="model"
                                                      Data="@ProductModels" @bind-Value="@NewTProductSpec.ProductModel"
                                                      Filterable="true"
                                                      FilterOperator="@StringFilterOperator.Contains"
                                                      FilterDebounceDelay="100">
                                    <NoDataTemplate>
                                        <div>
                                            <TelerikFontIcon Icon="@FontIcon.InfoCircle" Size="@ThemeConstants.FontIcon.Size.Large" />
                                            모델정보가 없습니다. 서버연결을 확인하세요.
                                        </div>
                                    </NoDataTemplate>
                                </TelerikDropDownList>
                            </Template>
                        </FormItem>

                        <FormItem Field="@nameof(NewTProductSpec.ProductType)">
                            <Template>
                                <label for="ptype" class="k-label k-form-label">검사형태</label>
                                <TelerikDropDownList Id="ptype" Data="@ProductTypes" @bind-Value="@NewTProductSpec.ProductType"></TelerikDropDownList>
                            </Template>
                        </FormItem>
                        <FormItem Field="@nameof(NewTProductSpec.ProductSerial)">
                            <Template>
                                <label for="sn" class="k-label k-form-label">제품SN</label>
                                <TelerikTextBox Id="sn" @bind-Value="@NewTProductSpec.ProductSerial"></TelerikTextBox>
                            </Template>
                        </FormItem>
                    </FormItems>

                    <FormButtons>
                            <TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)" Icon="FontIcon.PlusCircle" Size="Big">추가</TelerikButton>
                    </FormButtons>

                </TelerikForm>

            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal" @onclick="() => Close()">닫기</button>
            </div>
        </div>
    </div>
</div>


<style>
    .fims-dialog {
        /* margin-left: 50px;*/ 
        background-color: silver;
    }
</style>


<style>
    .dialog-background {
        color: darkblue;
        background-color:silver;
    }

    .dialog-header-background {
        color: darkred;
        background-color:silver;
    }
    .dialog-body-background {
        color: black;
        background-color:silver;
    }

</style>



@if (showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public RenderFragment Title { get; set; }

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    private string modalDisplay = "none;";
    private string modalClass = "";
    private bool   showBackdrop = false;

    public void Open()
    {
        modalDisplay = "block;";
        modalClass = "show";
        showBackdrop = true;
    }

    public void Close()
    {
        modalDisplay = "none";
        modalClass = "";
        showBackdrop = false;
    }
}