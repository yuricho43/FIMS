@page "/account/userprofiledialog"


<TelerikDialog Visible="@DialogVisible" Width="500px" Title="사용자 정보" ShowCloseButton="false" Class="fims-dialog">
    <DialogContent>
 
        <TelerikForm Model="@CurrentUserProfileModel"
                     Orientation="FormOrientation.Horizontal"
                     OnValidSubmit="@HandleValidSubmit"
                     OnInvalidSubmit="@HandleInvalidSubmit">
            <FormValidation>
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidation>
            <FormItems>
                <FormItem Field="@nameof(CurrentUserProfileModel.UserName)" Enabled="true">
                    <Template>
                        <label for="username" class="k-label k-form-label">사용자 ID:</label>
                        <TelerikTextBox Id="username" @bind-Value="@CurrentUserProfileModel.UserName"></TelerikTextBox>
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(CurrentUserProfileModel.HangulName)" Enabled="true">
                    <Template>
                        <label for="hangulname" class="k-label k-form-label">이름:</label>
                        <TelerikTextBox Id="hangulname" @bind-Value="@CurrentUserProfileModel.HangulName"></TelerikTextBox>
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(CurrentUserProfileModel.Email)" Enabled="true">
                    <Template>
                        <label for="email" class="k-label k-form-label">이메일:</label>
                        <TelerikTextBox Id="email" @bind-Value="@CurrentUserProfileModel.Email"></TelerikTextBox>
                    </Template>
                </FormItem>
                <FormItem Field="@nameof(CurrentUserProfileModel.Role)" Enabled="true">
                    <Template>
                        <label for="role" class="k-label k-form-label">권한:</label>
                        <TelerikTextBox Id="role" @bind-Value="@CurrentUserProfileModel.Role"></TelerikTextBox>
                    </Template>
                </FormItem>
            </FormItems>

            <FormButtons>
                <TelerikButton ButtonType="ButtonType.Button" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)" Icon="FontIcon.Password" OnClick="@(() => ChangePasswordDialogVisible = true)">암호 변경</TelerikButton>
            </FormButtons>

        </TelerikForm>


    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" OnClick="@(() => OnConfirm())">확인</TelerikButton>
    </DialogButtons>
</TelerikDialog>



@if (ChangePasswordDialogVisible)
{
    <ChangePasswordDialog ChangePasswordDialogFinished="OnChangePasswordDialogFinished"></ChangePasswordDialog>
}


<style>
    .fims-dialog {
        /* margin-left: 50px;*/ 
        background-color: silver;
    }
</style>
