@page "/account/changepasswordmodal"

<div class="modal @modalClass" tabindex="-1" role="dialog" style="display:@modalDisplay; overflow-y: auto;">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content dialog-background">
            <div class="modal-header dialog-header-background">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>


            <div class="modal-body dialog-body-background">

                @*<ErrorsList ShowErrors="ShowErrors" Errors="Errors" />*@

                <TelerikForm Model="@ChangePasswordModel"
                             Orientation="FormOrientation.Vertical"
                             OnValidSubmit="@HandleValidSubmit"
                             OnInvalidSubmit="@HandleInvalidSubmit"
                             Class="form-in-dialog">
                    <FormValidation>
                        <DataAnnotationsValidator></DataAnnotationsValidator>
                    </FormValidation>
                    <FormItems>
                        <FormItem Field="@nameof(ChangePasswordModel.Password)">
                            <Template>
                                <label for="pass" class="k-label k-form-label">현재 암호*:</label>
                                <TelerikTextBox Id="pass" @bind-Value="@ChangePasswordModel.Password" Password="true"></TelerikTextBox>
                                <TelerikValidationMessage For="@(() => ChangePasswordModel.Password)"></TelerikValidationMessage>
                            </Template>
                        </FormItem>

                        <FormItem Field="@nameof(ChangePasswordModel.NewPassword)">
                            <Template>
                                <label for="new-pass" class="k-label k-form-label">새 암호*:</label>
                                <TelerikTextBox Id="new-pass" @bind-Value="@ChangePasswordModel.NewPassword" Password="true"></TelerikTextBox>
                                <TelerikValidationMessage For="@(() => ChangePasswordModel.NewPassword)"></TelerikValidationMessage>
                            </Template>

                        </FormItem>

                        <FormItem Field="@nameof(ChangePasswordModel.ConfirmNewPassword)">
                            <Template>
                                <label for="new-confirm-pass" class="k-label k-form-label">새 암호 확인*:</label>
                                <TelerikTextBox Id="new-confirm-pass" @bind-Value="@ChangePasswordModel.ConfirmNewPassword" Password="true"></TelerikTextBox>
                                <TelerikValidationMessage For="@(() => ChangePasswordModel.ConfirmNewPassword)"></TelerikValidationMessage>
                            </Template>

                        </FormItem>
                    </FormItems>

                    <FormButtons>
                        @*<TelerikButton ButtonType="ButtonType.Submit" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)">변경</TelerikButton>*@
                        <button type="submit" class="btn btn-danger">변경</button>
                    </FormButtons>

                </TelerikForm>
            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal" @onclick="() => Close()">닫기</button>
            </div>
        </div>
    </div>
</div>


<style>
    .fims-dialog {
        /* margin-left: 50px;*/
        background-color: silver;
    }
</style>


<style>
    .dialog-background {
        color: darkblue;
        background-color: silver;
    }

    .dialog-header-background {
        color: darkred;
        background-color: silver;
    }

    .dialog-body-background {
        color: black;
        background-color: silver;
    }

</style>



@if (showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public RenderFragment Title { get; set; }

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    private string modalDisplay = "none;";
    private string modalClass = "";
    private bool   showBackdrop = false;

    public void Open()
    {
        modalDisplay = "block;";
        modalClass = "show";
        showBackdrop = true;
    }

    public void Close()
    {
        modalDisplay = "none";
        modalClass = "";
        showBackdrop = false;
    }
}


<TelerikNotification @ref="@ChangePasswordNotificationComponent"
                     Class="TSeetSpecsNotification"
                     VerticalPosition="NotificationVerticalPosition.Top"
                     HorizontalPosition="NotificationHorizontalPosition.Center">
</TelerikNotification>

