@using System.Collections.ObjectModel;


<div class="toolbar-row">
<TelerikStackLayout Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Center" Spacing="50px" Width="100%" Height="30px">
    <TelerikStackLayout Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Stretch" VerticalAlign="StackLayoutVerticalAlign.Center" Spacing="20px" Width="100%">
        <div class="toolbar-block">제품SN:&nbsp;<strong>@MyTSheetSpec.ProductSerial</strong></div>
        <div class="toolbar-block">모델:&nbsp;<strong>@MyTSheetSpec.ProductModel</strong></div>
        <div class="toolbar-block">고객:&nbsp;<strong>@MyTSheetSpec.Customer</strong></div>
        <div class="toolbar-block">EndUser:&nbsp;<strong>@MyTSheetSpec.EndUser</strong></div>
        <div class="toolbar-block">검사자:&nbsp;<strong>@MyTSheetSpec.InspectorName</strong></div>
    @if (MyTSheetSpec.IsInClosing)
    {
        <div class="toolbar-block">마무리:&nbsp;<strong>@MyTSheetSpec.CloserName</strong></div>
    }
    </TelerikStackLayout>
 
    <TelerikStackLayout Orientation="StackLayoutOrientation.Horizontal" HorizontalAlign="StackLayoutHorizontalAlign.Right" VerticalAlign="StackLayoutVerticalAlign.Center" Spacing="20px">
            <TelerikButton Icon="@FontIcon.Save" OnClick="@SaveUponCompletion" ThemeColor="@(ThemeConstants.Button.ThemeColor.Error)" Class="save-button"><strong>입력완료/저장</strong></TelerikButton>
    </TelerikStackLayout>
</TelerikStackLayout>
</div>


<div style="height: 10px;"></div>


@*<TelerikTabStrip @bind-ActiveTabIndex="@ActiveCategoryTabIndex" Class="fims-tab">*@
@*<TelerikTabStrip ActiveTabIndex="@MyTSheetSpec.ActiveCategoryTabIndex" ActiveTabIndexChanged="@((int i) => ActiveTabIndexChangedHandler(i))" PersistTabContent="true">*@
<TelerikTabStrip ActiveTabIndex="@MyTSheetSpec.ActiveCategoryTabIndex" ActiveTabIndexChanged="@((int i) => ActiveTabIndexChangedHandler(i))">
    @*@foreach (var TCategory in MyTSheetSpec.TCategories)*@
    @foreach (var TCategory in TCategories)
    {
        <TabStripTab>
            <HeaderTemplate>
                <div>
                    <span style="color:white"><strong>@TCategory</strong></span>
 
                    <span>&nbsp;</span>
                    @if (MyTSheetSpec.TItemsCountInCategoryDict[TCategory] - MyTSheetSpec.TItemSpecsCompletedCountInCategoryDict[TCategory] > 0)
                    {
                        <span class="badge badge-warning" style="width: 30px">@(MyTSheetSpec.TItemsCountInCategoryDict[TCategory] - MyTSheetSpec.TItemSpecsCompletedCountInCategoryDict[TCategory])</span>
                    }
                    else
                    {
                        if (MyTSheetSpec.TItemSpecsInvalidCountInCategoryDict[TCategory] > 0)
                        {
                            <span class="badge badge-warning" style="width: 30px">@(MyTSheetSpec.TItemsCountInCategoryDict[TCategory] - MyTSheetSpec.TItemSpecsCompletedCountInCategoryDict[TCategory])</span>
                        }
                        else
                        {
                            <span class="badge badge-success" style="width: 30px">@(MyTSheetSpec.TItemsCountInCategoryDict[TCategory] - MyTSheetSpec.TItemSpecsCompletedCountInCategoryDict[TCategory])</span>
                        }
                    }
                </div>
            </HeaderTemplate>
            <Content>
                <div style="background-color:#d8d9e8;">
                    <TSheetCategoryComponent MyTSheetSpec="MyTSheetSpec" TCategory="@TCategory" TItemSpecsCompletedCountInCategoryChanged="OnTItemSpecsCompletedCountInCategoryChanged" TItemSpecsInvalidCountInCategoryChanged="OnTItemSpecsInvalidCountInCategoryChanged"></TSheetCategoryComponent>
                </div>
            </Content>
        </TabStripTab>
    }
</TelerikTabStrip>


<TelerikNotification @ref="@TSheetComponentNotificationComponent"
                     Class="demo-notification"
                     VerticalPosition="NotificationVerticalPosition.Top"
                     HorizontalPosition="NotificationHorizontalPosition.Center">
</TelerikNotification>


