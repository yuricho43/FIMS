@using Telerik.Blazor.Components.Common.Icon


<TelerikGrid Data=@MyCategoryTItemSpecs
             EditMode="@GridEditMode.Incell"
             SelectionMode="GridSelectionMode.Multiple"
             @ref="@TItemSpecGrid"
             OnUpdate="@UpdateHandler" OnEdit="@EditHandler" OnDelete="@DeleteHandler" OnCreate="@CreateHandler"
             OnRowRender="@OnRowRenderHandler"
             Pageable="true"
             Resizable="true"
             @bind-PageSize="@PageSize"
             @bind-Page="@CurrentPage">

@*    <GridToolBar>
        <GridSearchBox Width="150px"></GridSearchBox>
        <span class="k-toolbar-spacer"></span>
        <GridCommandButton Command="ExcelExport" Icon="file-excel">@Localizer["Grid_ExcelExport"]</GridCommandButton>
        <GridCommandButton Command="CsvExport" Icon="file-csv">@Localizer["Grid_CsvExport"]</GridCommandButton>
    </GridToolBar>
*@
    <GridColumns>
        <GridColumn Field="@nameof(TItemSpec.TestNo)" Width="50px" Title="TestNo" Editable="false" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
            <HeaderTemplate><strong>Test No</strong></HeaderTemplate>
            <Template>
                <span class="k-badge k-badge-lg k-badge-solid k-badge-solid-success k-rounded-lg">@((context as TItemSpec).TestNo)</span>
            </Template>
        </GridColumn>

        @*<GridColumn Field="@nameof(TItemSpec.Title)" Width="200px" Title="항목" OnCellRender="@OnCellRenderHandler" HeaderClass="align-right right-padding" TextAlign="@ColumnTextAlign.Right">*@                            
        <GridColumn Field="@nameof(TItemSpec.Title)" Width="150px" Title="항목" Editable="false" HeaderClass="align-right right-padding">
            <HeaderTemplate><strong>시험항목</strong></HeaderTemplate>
            <Template>
                <span>@((context as TItemSpec).Title)</span>
                <TelerikTooltip TargetSelector=".tooltip-target" />
                <span title="@((context as TItemSpec).RangeToolTip)" class="tooltip-target" style="float:right"><TelerikIcon Icon="@FontIcon.QuestionCircle" /></span>
            </Template>
        </GridColumn>

        <GridColumn Field="@nameof(TItemSpec.Ch1Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch1Data"))" Title="CH1" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
            <HeaderTemplate><strong>CH1</strong></HeaderTemplate>
            <EditorTemplate>
                @{
                    var tItemSpec = context as TItemSpec;
                    //<TelerikTextBox @bind-Value=tItemSpec.Ch1Data Enabled=tItemSpec.IsCh1DataEnabled></TelerikTextBox>
                    if (tItemSpec.IsCh1DataEnabled)
                    {
                        if (tItemSpec.ExpressionMode == "String/Combo")
                        {
                            <TelerikDropDownList Data="@tItemSpec.UnitList" @bind-Value="@tItemSpec.Ch1Data" Class="k-focused-cell" />
                        }
                        else
                        {
                            <TelerikTextBox @bind-Value=tItemSpec.Ch1Data Class="k-grid k-focused-cell"></TelerikTextBox>
                        }
                    }
                    else
                    {
                        <div tabindex="0" style="display:none"></div>
                    }
                }
            </EditorTemplate>
        </GridColumn>

        <GridColumn Field="@nameof(TItemSpec.Ch2Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch2Data"))" Title="CH2" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
            <HeaderTemplate><strong>CH2</strong></HeaderTemplate>
            <EditorTemplate>
                @{
                    var tItemSpec = context as TItemSpec;
                    //<TelerikTextBox @bind-Value=tItemSpec.Ch2Data Enabled=tItemSpec.IsCh2DataEnabled></TelerikTextBox>
                    if (tItemSpec.IsCh2DataEnabled)
                    {
                        if (tItemSpec.ExpressionMode == "String/Combo")
                        {
                            <TelerikDropDownList Data="@tItemSpec.UnitList" @bind-Value="@tItemSpec.Ch2Data" Class="k-focused-cell" />
                        }
                        else
                        {
                            <TelerikTextBox @bind-Value=tItemSpec.Ch2Data Class="k-grid k-focused-cell"></TelerikTextBox>
                        }
                    }
                    else
                    {
                        <div tabindex="0" style="display:none"></div>
                    }
                }
            </EditorTemplate>
        </GridColumn>
 
        <GridColumn Field="@nameof(TItemSpec.Ch3Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch3Data"))" Title="CH3" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
            <HeaderTemplate><strong>CH3</strong></HeaderTemplate>
            <EditorTemplate>
                @{
                    var tItemSpec = context as TItemSpec;
                    //<TelerikTextBox @bind-Value=tItemSpec.Ch3Data Enabled=tItemSpec.IsCh3DataEnabled></TelerikTextBox>
