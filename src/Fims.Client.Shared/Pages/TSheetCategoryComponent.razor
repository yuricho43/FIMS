                        }
                    }
                    else
                    {
                        <div tabindex="0" style="display:none"></div>
                    }
                }
            </EditorTemplate>
        </GridColumn>

        <GridColumn Field="@nameof(TItemSpec.Ch4Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch4Data"))" Title="CH4" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
            <HeaderTemplate><strong>CH4</strong></HeaderTemplate>
            <EditorTemplate>
                @{
                    var tItemSpec = context as TItemSpec;
                    //<TelerikTextBox @bind-Value=tItemSpec.Ch4Data Enabled=tItemSpec.IsCh4DataEnabled></TelerikTextBox>
                    if (tItemSpec.IsCh4DataEnabled)
                    {
                        if (tItemSpec.ExpressionMode == "String/Combo")
                        {
                            <TelerikDropDownList Data="@tItemSpec.UnitList" @bind-Value="@tItemSpec.Ch4Data" Class="k-focused-cell" />
                        }
                        else
                        {
                            <TelerikTextBox @bind-Value=tItemSpec.Ch4Data Class="k-grid k-focused-cell"></TelerikTextBox>
