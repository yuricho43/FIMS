@using Telerik.Blazor.Components.Common.Icon


<TelerikTabStrip @bind-ActiveTabIndex="@ActiveCategoryTabIndex">
    @foreach (var TCategory in MyTSheetSpec.TCategories)
    {
        <TabStripTab>
            <HeaderTemplate>
                @*                <span class="k-icon flag italy-flag"></span>*@
                @*                <span class="fa fa-car" style="font-size:20px;color:red;"></span>*@
                @*                  <span class="fa fa-temperature-high"></span><strong>@TCategory</strong>*@
                @*                    <div style="background-color:orange;color:@SelectedColor;padding:20px;"><span class="fa fa-temperature-high"></span><strong>@TCategory</strong></div>*@
                <div class="tab-parent "><span class="fa fa-temperature-high"></span><strong>@TCategory</strong></div>
            </HeaderTemplate>
            <Content>
                <TelerikGrid Data=@MyTSheetSpec.TItemSpecsInCategoryDict[TCategory]
                             EditMode="@GridEditMode.Incell"
                             SelectionMode="GridSelectionMode.Multiple"
                             @ref="@TItemSpecGrid"
                             OnUpdate="@UpdateHandler" OnEdit="@EditHandler"
                             OnRowRender="@OnRowRenderHandler"
                             Height="480px"
                             Pageable="true"
                             Resizable="true"
                             Page="@Page"
                             Class="batch-grid">

                    @*<GridToolBar>
                        <GridSearchBox Width="150px"></GridSearchBox>
                        <span class="k-toolbar-spacer"></span>
                        <GridCommandButton Command="ExcelExport" Icon="file-excel">@Localizer["Grid_ExcelExport"]</GridCommandButton>
                        <GridCommandButton Command="CsvExport" Icon="file-csv">@Localizer["Grid_CsvExport"]</GridCommandButton>
                    </GridToolBar>*@

                    <GridColumns>
                        <GridColumn Field="@nameof(TItemSpec.TestNo)" Width="100px" Title="TestNo" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>Test No</strong></HeaderTemplate>
                            <Template>
                                <span class="k-badge k-badge-lg k-badge-solid k-badge-solid-success k-rounded-lg">@((context as TItemSpec).TestNo)</span>
                            </Template>
                        </GridColumn>
                        @*<GridColumn Field="@nameof(TItemSpec.Title)" Width="200px" Title="항목" OnCellRender="@OnCellRenderHandler" HeaderClass="align-right right-padding" TextAlign="@ColumnTextAlign.Right">*@
                        <GridColumn Field="@nameof(TItemSpec.Title)" Width="200px" Title="항목" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Title"))" HeaderClass="align-right right-padding">
                            <HeaderTemplate><strong>시험항목</strong></HeaderTemplate>
                            <Template>
                                <span>@((context as TItemSpec).Title)</span>
                                <TelerikTooltip TargetSelector=".tooltip-target" />
                                <span title="@((context as TItemSpec).RangeToolTip)" class="tooltip-target" style="float:right"><TelerikIcon Icon="@FontIcon.QuestionCircle" /></span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Ch1Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch1Data"))" Title="CH1" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH1</strong></HeaderTemplate>
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Ch2Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch2Data"))" Title="CH2" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH2</strong></HeaderTemplate>
                        </GridColumn>
                        <GridColumn Field="@nameof(TItemSpec.Ch3Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch3Data"))" Title="CH3" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH3</strong></HeaderTemplate>
                        </GridColumn>
                    @if (MaxChannels> 3)
                    {
                        <GridColumn Field="@nameof(TItemSpec.Ch4Data)" Width="100px" OnCellRender="@((GridCellRenderEventArgs args) => OnCellRenderHandler(args, "Ch4Data"))" Title="CH4" HeaderClass="center-me" TextAlign="@ColumnTextAlign.Center">
                            <HeaderTemplate><strong>CH4</strong></HeaderTemplate>
                        </GridColumn>
                    }
                    </GridColumns>
                </TelerikGrid>

            </Content>
        </TabStripTab>
    }
</TelerikTabStrip>


<style>
    .italy-flag {
        background-image: url('https://demos.telerik.com/kendo-ui/content/web/drawer/italy-flag.png');
    }

    .germany-flag {
        background-image: url('https://demos.telerik.com/kendo-ui/content/web/drawer/germany-flag.png');
    }

    .france-flag {
        background-image: url('https://demos.telerik.com/kendo-ui/content/web/drawer/france-flag.png');
    }

    .flag {
        background-size: cover;
        margin-right: 8px;
    }
</style>

<style>
    .tab-parent .k-tabstrip-items li {
        color: yellow;
    }

        .tab-parent .k-tabstrip-items li.k-state-active,
        .tab-parent .k-tabstrip-items li.k-state-active ~ li {
            color: red;
        }
</style>


<style>
    /* CENTER */

    /* non-sortable headers */
    .k-grid th.center-me {
        text-align: center;
    }

    /* sortable headers */
    th.center-me .k-cell-inner > .k-link {
        justify-content: center;
    }

    /* RIGHT */

    /* non-sortable headers */
    .k-grid th.align-right {
        text-align: right;
    }

    /* sortable headers */
    th.align-right .k-cell-inner > .k-link {
        justify-content: right;
    }

    /* unbound and non-filterable columns */
    .k-grid-header th.align-right.right-padding {
        padding-right: 12px;
    }

    /* filterable grid, sortable non-filterable columns */
    .k-grid-header th.align-right.right-padding > .k-cell-inner {
        margin-right: 0;
    }

</style>

<style>
    .userinput-valid {
        color: green;
        font-weight: bold !important;
    }

    .userinput-invalid {
        color: red !important;
        font-weight: bold;
        opacity: 0.7;
    }
</style>

<style>
    .batch-grid td:first-child,
    .batch-grid th:first-child {
        text-align: center !important;
    }

    .batch-grid .k-new-row, .batch-grid .k-changed-cell {
        background-color: rgb(94, 194, 50, 0.5) !important;
    }

    .batch-grid .k-disabled-cell {
        background-color: rgb(94, 94, 94, 0.5) !important;
    }

    .batch-grid .k-new-row:hover {
        background-color: rgb(194, 94, 50, 0.6) !important;
    }

    .batch-grid .k-deleted-row td:not(:first-child):not(.k-command-cell) {
        outline: none;
        cursor: default;
        opacity: 0.6;
        filter: grayscale(0.1);
        pointer-events: none;
        box-shadow: none;
    }
</style>

