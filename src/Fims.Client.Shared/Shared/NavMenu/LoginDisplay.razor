@using Microsoft.AspNetCore.Components.Authorization
@*@using Microsoft.AspNetCore.Components.WebAssembly.Authentication*@
@using System.Security.Cryptography
@using System.Text

@inject NavigationManager Navigation
@*@inject SignOutSessionStateManager SignOutManager*@


<div class="user-info">
    <AuthorizeView>
        <Authorizing>
            <text>...</text>
        </Authorizing>
        <Authorized>
            <img src="_content/Fims.Client.Shared/images/user.svg" />
            <div>
                <a href="/Account/UserProfile" class="username">@UserName</a>
            </div>
            &nbsp;
            <div>
                <button class="btn btn-link username" @onclick="BeginSignOut">로그아웃</button>

            </div>
        </Authorized>
        <NotAuthorized>
            <a class="sign-in" href="/Account/Login">로그인</a>
        </NotAuthorized>
    </AuthorizeView>
</div>


