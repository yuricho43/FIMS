<style>
    .user-info {
        margin-left: auto;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }

    .user-info img {
        margin-right: 0.7rem;
        width: 2.6rem;
    }

    .user-info .username {
        display: block;
        font-weight: 700;
        line-height: 0.7rem;
        margin-top: 0.5rem;
        color: white;
        font-size: 1rem;
    }

    .user-info a {
        color: #fff2cc;
        font-size: 0.8rem;
    }

    .user-info button.sign-out {
        color: #fff2cc;
        font-size: 0.8rem;
        padding: 0;
    }

</style>
