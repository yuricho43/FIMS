@namespace Fims.Client.Shared.Shared
@using Fims.Client.Shared.Shared.NavMenu

@inherits LayoutComponentBase
@inject ITelerikStringLocalizer Localizer
@inject LocalStorageInterop LocalStorageInterop
@*@inject ILocalStorageService LocalStorage*@
@*@inject Services.PublicHttp Http*@
@inject MainLayoutState Layout

<TelerikRootComponent>
    <div class="header">
        <div class="nav-container">
            <div class="menu-button">
                <TelerikButton Icon="menu" OnClick="ToggleMenuDrawer" />
            </div>
            <div class="title">
                <h1>@Localizer["Fims_Title"]</h1>
            </div>
            @{
                if (!WindowWidthSmall)
                {
                    <SettingsChooser></SettingsChooser>
                }
            }
        </div>
    </div>
    <TelerikDrawer @ref="MenuDrawer"
                   Expanded="@DrawerExpanded"
                   ExpandedChanged="((bool newValue) => ExpandedChangedHandler(newValue))"
                   Width="190px" Data="DrawerItems" Mode="DrawerMode.Push" Position="DrawerPosition.Left" MiniMode="true">
        <Template>
            <DrawTemplate Data="context"></DrawTemplate>
        </Template>
        <DrawerContent>
            @Body
        </DrawerContent>
    </TelerikDrawer>
</TelerikRootComponent>

<TelerikMediaQuery Media="(max-width: 768px)" OnChange="((changed) => WindowWidthSmall = changed)"></TelerikMediaQuery>

@code {
    TelerikDrawer<DrawerItem> MenuDrawer { get; set; }

    bool DrawerExpanded { get; set; }
    bool SettingsExpanded { get; set; }
    bool WindowWidthSmall {get; set; }

    IEnumerable<DrawerItem> DrawerItems =>
    new List<DrawerItem>
    {
        new DrawerItem{ Text = Localizer["Drawer_Home"], Icon = "grid", Url="/", Group = "home"},
        new DrawerItem{ Text = Localizer["Drawer_Settings"], Icon = "gear", Url="/BarcodeScanner", Group = "app"},
        new DrawerItem{ Text = Localizer["Drawer_Profile"], Icon = "user", Url="/account/settings", Group = "app"},
        new DrawerItem{ Text = Localizer["Drawer_Info"], Icon = "information", Url="/Management/TSheetManagement", Group = "ext"}
    };
      
    async Task ToggleMenuDrawer()
    {
        if (DrawerExpanded)
        {
            await MenuDrawer.CollapseAsync();
        }
        else
        {
            await MenuDrawer.ExpandAsync();
        }
    }

    async Task ExpandedChangedHandler(bool value)
    {
        DrawerExpanded = value;

        //await LocalStorage.SetItemAsync("drawerState", value);
        await LocalStorageInterop.SetItem("drawerState", value);
    }

    protected override async Task OnInitializedAsync()
    {
        //var hasKey = await LocalStorage.ContainKeyAsync("drawerState");
        var hasKey = await LocalStorageInterop.ContainKey("drawerState");
        if (hasKey)
        {
            //Expanded = await LocalStorage.GetItemAsync<bool>("drawerState");
            DrawerExpanded = await LocalStorageInterop.GetItem<bool>("drawerState");
        }
        else
        {
            DrawerExpanded = false;
        }

        // Layout.LayoutStateChange = async () =>
        // {
        // };

        // await InvokeAsync(Layout.LayoutStateChange);
    }
}