        position: relative;
        width: 100%;
        height:90%;
        //background-color: crimson;
    }

    .k-drawer-content {
        padding: 15px;
        //font-size: 18px;
        //background-color: lightseagreen;
    }

    .k-drawer-content h6 {
        margin-top: 15px;
        //background-color: darksalmon;
    }

    .custom-toolbar {
        width: 100%;
        background-color: coral;
        line-height: 10px;
        border-bottom: inset;
        border-bottom-width: 1px;
        padding: 3px 8px;
        color: #656565;
    }
</style>